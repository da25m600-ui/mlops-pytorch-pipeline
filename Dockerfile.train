# Stage 1: Build & Vendor Dependencies
FROM python:3.11-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/train.txt .
RUN pip install --no-cache-dir --user -r train.txt

# Stage 2: Minimalist Training Runtime
FROM python:3.11-slim AS training

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# Copy installed packages from the builder stage
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY src/ ./src/
COPY configs/ ./configs/

# Create dynamic volumes paths explicitly 
RUN mkdir -p /app/data /app/checkpoints

ENTRYPOINT ["python", "src/train.py"]
